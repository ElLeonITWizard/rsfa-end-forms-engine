# Copy to .env (git-ignored) for local `serve`. No secret is needed for tests.
PORT=8080
# 127.0.0.1 for local; the container sets 0.0.0.0
ENGINE_BIND=127.0.0.1
# API_KEY | PLATFORM_IAM | NONE (NONE only allowed on loopback)
ENGINE_AUTH=API_KEY
# >= 32 chars; generate locally, never commit. On GCP this would come from Secret Manager.
ENGINE_API_KEY=
ENGINE_MAPPINGS_DIR=mappings
# ':'-separated list; private lender PDFs extracted by tools/import_mforge.py
ENGINE_TEMPLATE_DIRS=.local/generated/templates
