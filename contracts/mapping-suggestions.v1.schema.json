{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsfa.co.nz/contracts/mapping-suggestions.v1.schema.json",
  "title": "Mapping suggestions v1 (D-039)",
  "description": "Provider-independent contract between the administration area and a mapping-suggestion provider (mock today; an AI model only after RSFA approves one). The request carries template STRUCTURE and the Monday column schema only: never data values, never PDF bytes. A response is a list of proposals a person accepts or rejects one by one; nothing is applied automatically. Mirrors engine/src/main/java/nz/co/rsfa/endforms/admin/MappingSuggestions.java.",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "templateKey", "dataPolicy", "fields", "columns", "references"],
      "properties": {
        "contractVersion": { "const": "mapping-suggestions.v1" },
        "templateKey": { "type": "string", "maxLength": 200 },
        "dataPolicy": { "const": "structure-only", "description": "No data values and no PDF bytes are sent." },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "kind", "options", "protectedField", "declarationLike", "alreadyMapped"],
            "properties": {
              "name": { "type": "string" },
              "kind": { "enum": ["text", "checkbox", "radio", "combo", "list", "signature", "button"] },
              "options": { "type": "array", "items": { "type": "string" } },
              "label": { "type": ["string", "null"], "description": "Printed label next to the field (template text, not data)." },
              "protectedField": { "type": "boolean", "description": "Signature or push button: the provider must refuse it." },
              "declarationLike": { "type": "boolean", "description": "Declaration, certification or consent: the provider must refuse it." },
              "alreadyMapped": { "type": "boolean" }
            }
          }
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "type", "labels"],
            "properties": {
              "id": { "type": "string", "description": "Stable Monday column ID." },
              "title": { "type": "string", "description": "Current title (the runtime key Make sends today)." },
              "type": { "type": "string" },
              "labels": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "references": {
          "type": "array",
          "description": "Fields of imported (MacroForge-derived) manifests and the key each one reads.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["templateKey", "pdfField", "sourceKey"],
            "properties": {
              "templateKey": { "type": "string" },
              "pdfField": { "type": "string" },
              "label": { "type": ["string", "null"] },
              "sourceKey": { "type": "string" }
            }
          }
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "provider", "generatedAt", "proposals", "refused", "unmatched"],
      "properties": {
        "contractVersion": { "const": "mapping-suggestions.v1" },
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "isMock", "notice"],
          "properties": {
            "id": { "type": "string" },
            "isMock": { "type": "boolean", "description": "true when the proposals do not come from an AI model; the UI must say so." },
            "model": { "type": ["string", "null"] },
            "notice": { "type": "string" }
          }
        },
        "generatedAt": { "type": "string", "format": "date-time" },
        "proposals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pdfField", "sourceType", "columnId", "columnTitle", "confidence", "evidence", "ambiguities", "alternatives"],
            "properties": {
              "pdfField": { "type": "string" },
              "sourceType": { "enum": ["column", "condition"], "description": "No constant, today or signature proposals." },
              "columnId": { "type": "string" },
              "columnTitle": { "type": "string" },
              "operator": { "enum": ["equals", "includes", "present", "absent", null] },
              "value": { "type": ["string", "null"], "description": "A Monday option LABEL from the schema, never a client value." },
              "option": { "type": ["string", "null"], "description": "Export value of the checkbox / radio option." },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1, "description": "The provider's estimate; never a permission to apply." },
              "evidence": { "type": "array", "items": { "type": "string" } },
              "ambiguities": { "type": "array", "items": { "type": "string" } },
              "alternatives": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["columnId", "columnTitle", "confidence"],
                  "properties": {
                    "columnId": { "type": "string" },
                    "columnTitle": { "type": "string" },
                    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
                  }
                }
              }
            }
          }
        },
        "refused": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pdfField", "reason"],
            "properties": { "pdfField": { "type": "string" }, "reason": { "type": "string" } }
          }
        },
        "unmatched": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "oneOf": [{ "$ref": "#/$defs/request" }, { "$ref": "#/$defs/response" }]
}
